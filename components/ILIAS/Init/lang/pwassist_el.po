msgid "password_assistance"
msgstr "Βοηθός κωδικού πρόσβασης"

#, fuzzy
msgid "pwassist_disabled_no_access"
msgstr "Password assistance is not enabled. Please contact the system administration for further assistance: %s"

msgid "pwassist_enter_email"
msgstr "Παρακαλώ εισάγετε μια νέα διεύθυνση email και υποβάλλετε τη φόρμα.\\nΤο ILIAS θα σας στείλει ένα email σ' αυτή τη διεύθυνση. Το email περιέχει όλα τα ονόματα χρηστών που έχουν εγγραφεί σ' αυτή τη διεύθυνση email.\\nΕπιλέξτε ένα κατάλληλο όνομα χρήστη και χρησιμοποιήστε την υπηρεσία κωδικών πρόσβασης για να ανακτήσετε ένα νέο password. Αν δεν λάβετε email από την υπηρεσία παρακαλώ επικοινωνήστε με το διαχειριστή του μαθήματος ή %1$s."

msgid "pwassist_enter_username_and_email"
msgstr "Εισάγετε ένα όνομα χρήστη και το αντίστοιχο email στα παρακάτω πεδία.\\nΤο ILIAS θα σας στείλει ένα μήνυμα σ' αυτή τη διεύθυνση email. Το μήνυμα περιέχει μια διεύθυνση για μια ιστοσελίδα όπου μπορείτε να εισάγετε ένα νέο κωδικό πρόσβασης για το λογαριασμό χρήστη.\\nΣε περίπτωση που δεν μπορείτε να εκχωρήσετε έναν κωδικό πρόσβασης στο λογαριασμό χρήστη κάνοντας χρήση αυτής τη φόρμας, επικοινωνήστε με το διαχειριστή του μαθήματος ή αποστείλετε ένα email στο %1$s."

msgid "pwassist_enter_username_and_new_password"
msgstr "Εισάγετε το όνομα χρήστη και το νέο κωδικό πρόσβασης στα παρακάτω πεδία."

msgid "pwassist_login_not_match"
msgstr "Παρακαλώ εισάγετε ένα νέο όνομα χρήστη.\\nΤο όνομα χρήστη που εισαγάγατε δεν ταιριάζει με το όνομα χρήστη για το οποίο ζητήσατε τη βοήθεια κωδικού πρόσβασης."

msgid "pwassist_mail_body"
msgstr "Εγγράψτε ένα νέο κωδικό πρόσβασης για το λογαριασμό χρήστη:\\n\\t%1$s\\n\\nΑυτό το μήνυμα δημιουργήθηκε αυτόματα από τον διακομιστή ILIAS\\n\\t%2$s\\n\\nΕσείς (ή κάποιος στο %3$s) ζήτησε υποστήριξη για κωδικό πρόσβασης για το λογαριασμό χρήστη \"%4$s\".\\n\\nΠαρακαλώ ελέγξτε με προσοχή τις συνθήκες που φαίνονται παρακάτω και προχωρήστε κατάλληλα:\\n\\n- Αν χρησιμοποιήσατε βοήθεια για κωδικό πρόσβασης κατά λάθος από το διακομιστή ILIAS:\\nΔιαγράψτε αυτό το mail.\\n\\n- Αν είστε σίγουροι ότι ποτέ δεν ζητήσατε βοήθεια για κωδικό πρόσβασης από αυτόν το διακομιστή ILIAS:\\nΠαρακαλώ επικοινωνήστε με %5$s.\\n\\n- Αν ζητήσατε βοήθεια κωδικού πρόσβασης, παρακαλώ προχωρήστε ως ακολούθως:\\n\\n1. Ανοίξτε τον πλοηγό σας.\\n\\n2. Εισάγετε την ακόλουθη διεύθυνση στον πλοηγό σας:\\n\\t%1$s\\n\\nΣημαντικό: Η διεύθυνση είναι σε μια γραμμή. Αν τη βλέπετε διαμοιρασμένη σε πολλές γραμμές, τότε το πρόγραμμα email σας εισήγαγε αυτές τις αλλαγές γραμμής.\\n\\n3. Στην ιστοσελίδα που εμφανίζεται στον πλοηγό σας, εισάγετε ένα νέο κωδικό πρόσβασης για το λογαριασμό σας χρήστη.\\n\\nΠαρακαλώ σημειώστε ότι για λόγους ασφαλείας, μπορείτε να εκτελέσετε τα παραπάνω τρία βήματα μια φορά μόνο και για περιορισμένο χρονικό διάστημα. Ύστερα, η διεύθυνση ακυρώνεται και πρέπει να χρησιμοποιήσετε τη σελίδα βοηθού κωδικού πρόσβασης του διακομιστή ILIAS πάλι."

msgid "pwassist_mail_sent"
msgstr "Ένα μήνυμα έχει σταλεί στο %1$s.\\nΠαρακαλώ ελέγξτε το ηλεκτρονικό ταχυδρομείο σας."

#, fuzzy
msgid "pwassist_mail_sent_generic"
msgstr "A message has been sent to the email address defined in ILIAS.\\nPlease check your mail box."

msgid "pwassist_mail_subject"
msgstr "Βοηθός κωδικού πρόσβασης ILIAS"

msgid "pwassist_password_assigned"
msgstr "Ο κωδικός πρόσβασης εκχωρήθηκε με επιτυχία στο χρήση \"%1$s\"."

msgid "pwassist_session_expired"
msgstr "Παρακαλώ συμπληρώστε πάλι τη φόρμα.\\nΗ σύνοδος βοήθειας κωδικού πρόσβασής σας έχει λήξει. Αυτό μπορεί να 'χει συμβεί επειδή προσπαθήσατε να χρησιμοποιήσετε περισσότερες από μια φορές τον υπερσύνδεσμο που σας ταχυδρομήθηκε ηλεκτρονικά, ή επειδή έχει περάσει πολύς χρόνος από που σας ταχυδρομήθηκε ο υπερσύνδεσμος."

msgid "pwassist_username_mail_body"
msgstr "Αυτό είναι το ενεργό όνομα χρήστη που βρέθηκε για το δωθέν email:\\n%s\\n\\nΑυτό το μήνυμα δημιουργήθηκε αυτόματα από τον ακόλουθο διακομιστή ILIAS:\\n\\t%s\\n\\nΕσείς (ή κάποιος με IP %s) ζήτησε υποστήριξη για ξεχασμένο όνομα χρήστη για τη διεύθυνση email '%s'.\\n\\nΠαρακαλώ ελέγξτε τα παρακάτω και δράστε ανάλογα::\\n\\n-Ζητήσατε αυτό το mail κατά λάθος:\\nΔιαγράψτε αυτό το email.\\n\\n-Είστε σίγουροι ότι ποτέ δεν ζητήσατε αυτό το email:\\nΠαρακαλώ επικοινωνήστε με %s.\\n\\n- Αν ζητήσατε αυτό το email, παρακαλώ προχωρήστε ως ακολούθως::\\n\\n1. Εκκινήστε τον πλοηγό σας internet.\\n\\n2. Εισάγετε το ακόλουθο url:\\n\\t%s\\n\\nΣημαντικό: Η διεύθυνση είναι σε μια γραμμή. Αν τη βλέπετε διαμοιρασμένη σε πολλές γραμμές, τότε το πρόγραμμα email σας εισήγαγε αυτές τις αλλαγές γραμμής.\\n\\n3. Ο Πλοηγός σας τώρα δείχνει την υπηρεσία κωδικών πρόσβασης. Χρησιμοποιήστε αυτή τη σελίδα μαζί με κάποιο από τα ονόματα χρήστη και την αντίστοιχη διεύθυνση email για να ανακτήσετε τον κωδικό πρόσβασης."

