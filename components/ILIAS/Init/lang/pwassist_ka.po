msgid "password_assistance"
msgstr "პაროლის დახმარება"

#, fuzzy
msgid "pwassist_disabled_no_access"
msgstr "Password assistance is not enabled. Please contact the system administration for further assistance: %s"

msgid "pwassist_enter_email"
msgstr "გთხოვთ შეიყვანოთ ემაილის მისამართი და ჩააბაროთ ფორმა.\\ნილიასი გააგზავნის ემაილს ამ მისამართზე. ემაილი შეიცავს ყველა მომხმარებლის სახელს რომელმაც დაარეგისტრირა ამ ემაილის მისამართი. \\ნ აირჩიეთ შესაფერისი მომხმარებლის სახელი და გამოიყენეთ პაროლის დახმარება იმისათვის რომ მიიღოთ ახალი პაროლი. თუ ვერ მიიღებთ ემაილს ამ სერვისით გთხოვთ დაუკავშირდეთ თქვენი კურსის ადმინისტრატორს ან %s 1$"

msgid "pwassist_enter_username_and_email"
msgstr "შეიყვანეთ ამ ემაილთან დაკავშირებული მომხმარებლის სახელი ქვემოთ მოცემულ ველში. ნილიასი გააგზავნის შეტყობინებას ამ ემაილის მისამართზე. შეტყობინება შეიცავს ვებ გვერდის მისამართს სადაც თქვენ შეძლებთ თქვენი პაროლის აღდგენას. \\ნ იმ შემთხვევაში თუ თქვენ ვერ შეძლებთ ამ ფორმიტ პაროლი აღდგენას დაუკავშირდით თქვენი კურსის ადმინისტრატორს ან გააგზავნეთ ემაილი %s1$"

msgid "pwassist_enter_username_and_new_password"
msgstr "შეიყვანეთ მომხმარებლის სახელი და ახალი პაროლი ქვემოტ მოცემულ ველში"

msgid "pwassist_login_not_match"
msgstr "გთხოვთ შეიყვანოთ მომხმარებლის სახელი. \\ნ მომხმარებლის სახელი რომელიც თქვენ შეიყვანეთ არ შეესატყვისება იმ მომხმარებლის სახელს რომლისთვისაც თქვენ პაროლის აღდგენა მოითხოვეთ."

msgid "pwassist_mail_body"
msgstr "\\n\\n- If you have used the password assistance form on the ILIAS server by accident"

msgid "pwassist_mail_sent"
msgstr "შეტყობინება გაგზავნილია %s1$. \\ნ გთხოვთ შეამოწმოთ თქვენი შეტყობინების ყუთი"

