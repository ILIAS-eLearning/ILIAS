msgid "pwassist_password_assigned"
msgstr "პაროლი წარმატებით დაინიშნა მომხარებელზე \"%s1$\"."

msgid "pwassist_session_expired"
msgstr "გთხოვთ ხელახლა შეავსოთ ეს ფორმა. \\ნ თქვენი პაროლის დახმარების სესია ამოიწურა. Eეს იმის გამო მოხდა რომ თქვენ გამოგზავნილი ლინკი რამდენიმეჯერ გამოიყენეთ ან დიდი დრო მოანდომეთ პაროლის აღდგენას"

msgid "pwassist_username_mail_body"
msgstr "\\n\\t%s\\n\\nYou (or somebody with IP  %s) have requested support for forgotten usernames for the e-mail address '%s'.\\n\\nPlease check the following and act as suggested"

