msgid "password_assistance"
msgstr "كلمة المرور المساعدة"

#, fuzzy
msgid "pwassist_disabled_no_access"
msgstr "Password assistance is not enabled. Please contact the system administration for further assistance: %s"

msgid "pwassist_enter_email"
msgstr "Please enter an e-mail address and submit the form.\\nILIAS will send an e-mail to that address. The e-mail contains all usernames which have registered this e-mail address.\\nChoose a suitable username and use the password service to retrieve a new password. If you do not retrieve any e-mail by this service please contact your course admin or %1$s."

msgid "pwassist_enter_username_and_email"
msgstr "Enter a user name and the associated e-mail address in the fields shown below.\\nILIAS will send a message to that e-mail address. The message contains an address for a web page, where you can enter a new password for the user account.\\nIn case you are unable to assign a password to your user account using this form, contact your course administration or send an e-mail to %1$s."

msgid "pwassist_enter_username_and_new_password"
msgstr "Enter the user name and the new password in the fields below."

msgid "pwassist_login_not_match"
msgstr "Please enter another user name.\\nThe user name you have entered does not match the user name for which you had asked for password assistance."

msgid "pwassist_mail_body"
msgstr "Register a new password for your user account:\\n\\t%1$s\\n\\nThis message has been generated automatically by the ILIAS server\\n\\t%2$s\\n\\nYou (or someone at %3$s) has asked for password assistance for the user account \"%4$s\".\\n\\nPlease check carefully the conditions listed below, and proceed accordingly:\\n\\n- If you have used the password assistance form on the ILIAS server by accident:\\nDelete this mail.\\n\\n- If you are certain, that you never asked for password assistance at this ILIAS server:\\nPlease contact %5$s.\\n\\n- If you asked for password assistance, please proceed as follows:\\n\\n1. Open your browser.\\n\\n2. Enter the following address in your browser:\\n\\t%6$s\\n\\nImportant: The address is a single line. If you see this address split into multiple lines, then your e-mail program has inserted these line breaks.\\n\\n3. On the web page shown by your browser, enter a new password for your user account.\\n\\nPlease note, that for security reasons, you can perform the three steps above only exactly once and for a limited time only. Afterwards the address becomes invalid, and you have to use the password assistance page on the ILIAS server again."

msgid "pwassist_mail_sent"
msgstr "A message has been sent to %1$s.\\nPlease check your mail box."

#, fuzzy
msgid "pwassist_mail_sent_generic"
msgstr "A message has been sent to the email address defined in ILIAS.\\nPlease check your mail box."

msgid "pwassist_mail_subject"
msgstr "ILIAS Password Assistance"

msgid "pwassist_password_assigned"
msgstr "The password has been successfully assigned to user \"%1$s\"."

msgid "pwassist_session_expired"
msgstr "Please fill in this form again.\\nYour password assistance session has expired. This may have happened, because you tried to use the link that has been sent by e-mail to you more than once, or because too much time has passed since the link has been sent to you."

msgid "pwassist_username_mail_body"
msgstr "هذا هو اسم المستخدم النشط الذي تم ايجاده لعنوان البريد الالكتروني المعطى:\\n%s\\n\\n لقد تم انشاء هذه الرسالة اليا بواسطة خادم ILIAS التالي:\\n\\t%s\\n\\nانت (او أي شخص ب IP %s) قام بطلب مساعدة لاسماء المستخدمين لعنوان البريد الالكتروني  ‘%s’.\\n\\nالرجاء فحص التالية والتصرف كما هو مقترح:\\n\\n-انت قمت بطلب هذا البريد الالكتروني عن طريق الصدفة:\\nاحذف هذا البريد الالكتروني.\\n\\n-هل انت متأكد من انك لم تطلب هذا البريد الالكتروني:\\nالرجاء الاتصال ب %s.\\n\\n-اذا قمت بطلب هذا البريد الالكتروني، الرجاء ابدأ بالتالي::\\n\\n1. ابدأ في متصفح الانترنت الخاص بك.\\n\\n2. ادخل url التالية:\\n\\t%s\\n\\nهام: العنوان عبارة عن سطر واحد. اذا رأيت العنوان قد توزع على عدة سطور، فلابد ان يكون برنامج البريد الالكتروني الخاص بك قام بإدراج فواصل السطور.\\n\\n3. يعرض متصفحك الان خدمة –كلمة المرور. استخدم هذه الصفحة جنبا الى جنب مع واحد من اسماء المستخدمين وعنوان البريد الالكتروني المحدد لتحديد كلمة مرور جديدة"

#, fuzzy
msgid "unassist_disabled_no_access"
msgstr "Username assistance is not enabled. Please contact the system administration for further assistance: %s"
