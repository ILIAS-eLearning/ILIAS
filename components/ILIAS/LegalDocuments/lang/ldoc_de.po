msgid "ldoc_crit_type_usr_country_info"
msgstr "Das Dokument muss akzeptiert werden, wenn beim ersten Login dieses Land gewählt wurde. Eine nachträgliche Änderung der Benutzersprache führt nicht automatisch zur Vorlage eines neuen Dokuments."

msgid "ldoc_crit_type_usr_global_role"
msgstr "Globale Rolle"

msgid "ldoc_crit_type_usr_global_role_info"
msgstr "Das Dokument muss akzeptiert werden, wenn ein Benutzer beim ersten Login in diese Rolle eingetragen ist. Eine nachträgliche Änderung der Rolle führt nicht automatisch zur Vorlage eines neuen Dokuments."

msgid "ldoc_crit_type_usr_language"
msgstr "Benutzersprache"

msgid "ldoc_crit_type_usr_language_info"
msgstr "Das Dokument muss akzeptiert werden, wenn beim ersten Login diese Sprache gewählt wurde. Eine nachträgliche Änderung der Benutzersprache führt nicht automatisch zur Vorlage eines neuen Dokuments."

msgid "ldoc_criterion_assignment_cannot_match"
msgstr "Sie können das Vorlagekriterium mit der entsprechenden Konfiguration nicht zuweisen. Durch ein anderes Vorlagekriterium wird das Dokument niemals zutreffen können."

msgid "ldoc_criterion_assignment_must_be_unique"
msgstr "Sie können das Vorlagekriterium mit der entsprechenden Konfiguration nicht zuweisen. Es existiert bereits eine identische Zuweisung."

