msgid "available_providers"
msgstr "Proveedores disponibles"

msgid "client_settings"
msgstr "Ajustes generales"

msgid "enable_osd"
msgstr "Habilitar notificaciones emergentes (Toasts)"

msgid "enable_osd_desc"
msgstr "Si está habilitado, los usuarios son notificados mediante una ventana emergente sobre nuevas notificaciones."

msgid "enable_push"
msgstr "Enable Push Notifications"

msgid "enable_push_desc"
msgstr "If enabled, users are notified by push notifications. User can change this behaviour within their user settings."

msgid "notification_settings"
msgstr "Ajustes de notificación"

msgid "osd_error_refresh_interval_too_small"
msgstr "El intervalo de actualización debe ser de al menos 3000 milisegundos."

msgid "osd_interval"
msgstr "Intervalo de actualización"

msgid "osd_interval_desc"
msgstr "Intervalo de sondeo para comprobar nuevas notificaciones en milisegundos. Un número menor notificará al usuario más rápidamente, pero aumenta el número de solicitudes que el servidor web debe manejar."

msgid "osd_play_sound"
msgstr "Reproducir un sonido"

msgid "osd_play_sound_desc"
msgstr "Reproducir un sonido al recibir una nueva notificación."

msgid "osd_settings"
msgstr "Notificaciones emergentes (Toasts)"

msgid "push_client_already_used"
msgstr "Push notifications are already used by another user for this client."

msgid "push_client_edge_case"
msgstr "The Edge Browser might have deactivated notifications without your consent. Enter your browser settings to reactivate them."

msgid "push_client_inactive"
msgstr "Push notifications are disabled for this website. Open your browser settings to activate them."

msgid "push_client_ios_case"
msgstr "If you are using IOS (Iphone, Ipad, Ipod) push notifications for websites are not supported. Create an access via web app to enable them."

msgid "push_settings"
msgstr "Push Notifications"

msgid "push_subscription_successfull"
msgstr "Push Notifications activation successful"

msgid "push_subscription_successfull_desc"
msgstr "This is a dummy notification to verify the successful activation of push notifications."

msgid "user_settings"
msgstr "Configuración del usuario"
