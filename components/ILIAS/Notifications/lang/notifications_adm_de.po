msgid "available_providers"
msgstr "Verfügbare Provider"

msgid "client_settings"
msgstr "Browsereinstellungen"

msgid "enable_osd"
msgstr "Pop-up-Benachrichtigungen aktivieren"

msgid "enable_osd_desc"
msgstr "Ein Pop-up erscheint bei neuen Benachrichtigungen."

msgid "enable_push"
msgstr "Push-Benachrichtigungen aktivieren"

msgid "enable_push_desc"
msgstr "Benachrichtigungen werden im Browser gepusht, auch wenn ILIAS aktuell nicht im Vordergrund ist. Diese Einstellung muss zusätzlich von jeder Person unter „Kommunikation > Push-Benachrichtigungen“ aktiviert werden."

msgid "notification_settings"
msgstr "Benachrichtigungseinstellungen"

msgid "osd_error_refresh_interval_too_small"
msgstr "Das Abfrageintervall muss mindestens 3000 Millisekunden betragen."

msgid "osd_interval"
msgstr "Abfrageintervall"

msgid "osd_interval_desc"
msgstr "Abfrageintervall für Benachrichtigungen in Millisekunden. Ein geringerer Wert ermöglicht schnellere Benachrichtigungen, erhöht aber die Serverlast."

msgid "osd_play_sound"
msgstr "Ton abspielen"

msgid "osd_play_sound_desc"
msgstr "Beim Erhalt einer neuen Benachrichtigung wird ein Ton abgespielt."

msgid "osd_settings"
msgstr "Pop-up-Benachrichtigungen"

msgid "push_client_already_used"
msgstr "Push-Benachrichtigungen wurden in diesem Browser schon von einem anderen ILIAS-Konto aus aktiviert."

msgid "push_client_edge_case"
msgstr "Möglicherweise wurden Benachrichtigungen durch Microsoft Edge deaktiviert. Reaktivieren Sie die Anzeige von Benachrichtigungen in den Einstellungen Ihres Browsers."

msgid "push_client_inactive"
msgstr "Push-Benachrichtigungen sind für diese Webseite deaktiviert. Reaktivieren Sie diese in den Einstellungen Ihres Browsers."

msgid "push_client_ios_case"
msgstr "Wenn sie iOS (iPhone, iPad, iPod) nutzen, werden keine Benachrichtigungen durch Webseiten unterstützt. Erstellen sie einen Web-App-Zugriff, um Benachrichtigungen nutzen zu können."

msgid "push_settings"
msgstr "Push-Benachrichtigungen"

msgid "push_subscription_successfull"
msgstr "Die Aktivierung der Push-Benachrichtigungen war erfolgreich."

msgid "push_subscription_successfull_desc"
msgstr "Dies ist eine Test-Benachrichtigung, um die erfolgreiche Aktivierung der Push-Benachrichtigungen zu bestätigen."

msgid "user_settings"
msgstr "Persönliche Einstellungen"
