msgid "available_providers"
msgstr "利用可能なプロバイダ"

msgid "client_settings"
msgstr "クライアント設定"

msgid "enable_osd"
msgstr "オンスクリーン通知を有効化"

msgid "enable_osd_desc"
msgstr "有効にすると新しい通知についてユーザはポップアップ通知されます。"

msgid "enable_push"
msgstr "プッシュ通知通知を有効化"

msgid "enable_push_desc"
msgstr "有効にすると、ユーザーはプッシュ通知で通知されます。ユーザーは自分のユーザー設定でこの動作を変更できます。"

msgid "notification_settings"
msgstr "通知設定"

msgid "osd_error_refresh_interval_too_small"
msgstr "リフレッシュ間隔は3000ミリ秒以上開ける必要があります。"

msgid "osd_interval"
msgstr "リフレッシュ間隔"

msgid "osd_interval_desc"
msgstr "ミリ秒内の新規通知チエック用のポーリング間隔。低い数字がユーザへ素早く通知されますが、Webサーバが処理する要求数の増加につながります。"

msgid "osd_play_sound"
msgstr "音を再生"

msgid "osd_play_sound_desc"
msgstr "新しい通知受信時に音を鳴らす。"

msgid "osd_settings"
msgstr "オンスクリーン通知"

msgid "push_client_already_used"
msgstr "このクライアントでは、プッシュ通知はすでに別のユーザーによって使用されています。"

msgid "push_client_edge_case"
msgstr "Edgeブラウザーは、あなたの同意なしに通知を無効にした可能性があります。通知を再有効化するには、ブラウザーの設定にアクセスしてください。"

msgid "push_client_inactive"
msgstr "このウェブサイトのプッシュ通知は無効になっています。有効にするにはブラウザの設定を開いてください。"

msgid "push_client_ios_case"
msgstr "もしあなたがiOS（iPhone、iPad、iPod）を使用している場合、ウェブサイトのプッシュ通知はサポートされていません。通知を有効にするには、ウェブアプリ経由でアクセスを作成してください。"

msgid "push_settings"
msgstr "プッシュ通知"

msgid "push_subscription_successfull"
msgstr "プッシュ通知有効化に成功"

msgid "push_subscription_successfull_desc"
msgstr "これは、プッシュ通知の有効化が成功したことを確認するためのダミー通知です。"

msgid "user_settings"
msgstr "ユーザ設定"
