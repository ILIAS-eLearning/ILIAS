msgid "lucene_err_ampersand"
msgstr "Les requêtes contenant les caractères spéciaux && doivent être sous la forme terme1 && terme2."

msgid "lucene_err_and_or_not"
msgstr "Les requêtes contenant AND/OR/NOT doivent être sous la forme terme1 AND|OR|NOT|AND NOT terme2."

msgid "lucene_err_asterisk"
msgstr "Le caractère de remplacement (*) doit être précédé par au moins une lettre ou un chiffre."

msgid "lucene_err_caret"
msgstr "Le caractère circonflexe (^) doit être précédé par un caractère alphanumérique et suivi par des chiffres."

msgid "lucene_err_colon"
msgstr "Déclarations de zone (:)Doit être précédé par au moins une lettre ou un chiffre et suivi par au moins une lettre ou un chiffre."

msgid "lucene_err_exclamation_mark"
msgstr "Les requêtes contenant le caractère spécial (!) doivent être sous la forme terme1 ! terme2."

msgid "lucene_err_parenthesis_empty"
msgstr "Les parenthèses doivent contenir au moins un caractère."

msgid "lucene_err_parenthesis_not_closed"
msgstr "Les parenthèses doivent être closes."

msgid "lucene_err_plus_minus"
msgstr "Les modificateurs (+) et (-) doivent être suivis par au moins une lettre ou un chiffre."

msgid "lucene_err_question_mark"
msgstr "Le caractère de questionnement (?) doit être précédé par au moins une lettre ou un chiffre."

msgid "lucene_err_quotes"
msgstr "Veuillez clore toutes les doubles apostrophes (\")."

msgid "lucene_err_quotes_not_empty"
msgstr "Les apostrophes (\") doivent contenir au moins un caractère."

