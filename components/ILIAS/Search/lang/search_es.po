msgid "lucene_err_ampersand"
msgstr "Las consultas que contienen los caracteres especiales && deben tener el formato: término1 && término2."

msgid "lucene_err_and_or_not"
msgstr "Las consultas que contienen AND/OR/NOT deben tener el formato: término1 AND|OR|NOT|AND NOT término2."

msgid "lucene_err_asterisk"
msgstr "El carácter comodín (*) debe ir precedido de al menos una letra o número."

msgid "lucene_err_caret"
msgstr "El carácter de intercalación (^) debe ir precedido de caracteres alfanuméricos y seguido de números."

msgid "lucene_err_colon"
msgstr "Las declaraciones de campo (:) deben ir precedidas de al menos una letra o número y seguidas de al menos una letra o número."

msgid "lucene_err_exclamation_mark"
msgstr "Las consultas que contienen el carácter especial (!) deben tener el formato: término1 ! término2."

msgid "lucene_err_parenthesis_empty"
msgstr "Los paréntesis deben contener al menos un carácter."

msgid "lucene_err_parenthesis_not_closed"
msgstr "Los paréntesis deben estar cerrados."

msgid "lucene_err_plus_minus"
msgstr "Los modificadores (+) y (-) deben ir seguidos de al menos una letra o número."

msgid "lucene_err_question_mark"
msgstr "El carácter de signo de interrogación (?) debe ir precedido de al menos una letra o número."

msgid "lucene_err_quotes"
msgstr "Por favor, cierre todas las comillas (\")."

msgid "lucene_err_quotes_not_empty"
msgstr "Las comillas (\") deben contener al menos un carácter."

