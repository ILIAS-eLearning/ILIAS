msgid "conf_privacy_ident_il_uuid_user_id_info"
msgstr "Envía el ID de usuario numérico interno. Esto es idéntico para cada llamada, pero puede permitir conclusiones sobre el usuario de ILIAS."

msgid "conf_privacy_ident_info"
