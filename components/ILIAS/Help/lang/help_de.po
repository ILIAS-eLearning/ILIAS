msgid "gdtr_table"
msgstr "Tabelle"

msgid "gdtr_table_info"
msgstr "Die erste Tabelle einer Seite"

msgid "gdtr_tabs"
msgstr "Reiter"

msgid "gdtr_tabs_ID_info"
msgstr "ID des gewünschten Reiters. Fahren Sie mit der Maus über einen Reiter, um die ID als Tooltipp zu sehen."

msgid "gdtr_tabs_info"
msgstr "Reiter werden unter dem Titel einer Seite dargestellt."

msgid "gdtr_toolbar"
msgstr "Toolbar"

msgid "gdtr_toolbar_info"
msgstr "Die Toolbar wird auf einigen Seiten unterhalb der Reiter dargestellt und enthält meistens mehrere Buttons."

msgid "gdtr_tour_has_been_reset"
msgstr "Die Tour wurde zurückgesetzt."

