msgid "trac_mode_collection"
msgstr "Status is Determined by a Collection of Items"

msgid "trac_mode_collection_info"
msgstr "A user's learning progress status is determined by the learning progress status of a collection of items:  If the status of all items in the collection is ‘Completed’ the overall status is ‘Completed’ .<br />Items can be assigned to the collection on this screen after saving this setting."

msgid "trac_mode_collection_manual"
msgstr "Users Monitor and Set Status per Chapter Themselves"

msgid "trac_mode_collection_manual_info"
msgstr "Users decide themselves if they have accomplished a chapter of the learning module. After completing a chapter, users have to set this chapter's status to ‘Completed’ on the 'Info'-tab. <br />Chapters can be selected as Progress-relevant on this screen after you have saved this setting."

msgid "trac_mode_collection_mobs"
msgstr "Collection of Media Objects"

msgid "trac_mode_collection_mobs_info"
msgstr "The learning progress status will be determined by the viewing status of selected media objects."

msgid "trac_mode_collection_tlt"
msgstr "Minimally Required Amount of Time Spent per Chapter"

msgid "trac_mode_collection_tlt_info"
msgstr "The status will be automatically set according to time a user spends working on the chapters . The status 'Completed' is assigned once users exceed the minimally required Typical Learning Time for all progress-relevant chapters.<br />The Typical Learning Time per chapter can be set on this screen after you have saved this setting."

msgid "trac_mode_content_visited"
msgstr "Visited"

msgid "trac_mode_content_visited_info"
msgstr "Learning progress status is set to 'completed' when object has been presented to user."

msgid "trac_mode_contribution_to_discussion"
msgstr "Contributions to Discussion"

msgid "trac_mode_contribution_to_discussion_info"
msgstr "The learning progress status will be determined by the number of written posts."

msgid "trac_mode_course_reference"
msgstr "Adopted from Course"

msgid "trac_mode_course_reference_info"
msgstr "The mode is automatically adopted from the course this course link points to."

msgid "trac_mode_deactivated"
msgstr "Learning Progress is Deactivated"

msgid "trac_mode_deactivated_info_new"
msgstr "The learning progress status is not displayed and does not influence parent objects."

msgid "trac_mode_event"
msgstr "Tutors Monitor and Record Attendance"

msgid "trac_mode_event_info"
msgstr "Tutors monitor whether or not participants attend the session. Tutors record attendance manually in the 'Participants'-tab."

msgid "trac_mode_exercise_returned"
msgstr "Tutors Monitor and Set Status"

msgid "trac_mode_exercise_returned_info"
msgstr "Tutors decide if users have accomplished the excercise. Tutors manually set the overall status i.e. ‘Completed’ or ‘Failed’."

msgid "trac_mode_individual_assessment"
msgstr "Graded manually by tutor or trainer"

msgid "trac_mode_individual_assessment_info"
msgstr "The record of a user has to be finalized by the tutor in order to complete individual assessment."

msgid "trac_mode_lti_outcome"
msgstr "Mastery Score Must be reached"

msgid "trac_mode_lti_outcome_info"
msgstr "The Learning Progress will be evaluated from the LTI outcome and the mastery score threshold."

msgid "trac_mode_manual"
msgstr "Users Monitor and Set Status Themselves (Complete Module)"

msgid "trac_mode_manual_by_tutor"
msgstr "Tutors Monitor and Set Status"

msgid "trac_mode_manual_by_tutor_info"
msgstr "Tutors decide if users have accomplished the object. Tutors manually set the overall status i.e. ‘Completed’ or ‘Failed’."

msgid "trac_mode_manual_info"
msgstr "Users decide themselves if they have accomplished the object. Once they are done, they have to set their status to ‘Completed’ on the ‘Learning Progress’ tab."

msgid "trac_mode_objectives"
msgstr "Status is Determined by Learning Objectives"

msgid "trac_mode_objectives_info"
msgstr "The learning progress will be automatically determined according to the number of passed learning objectives."

msgid "trac_mode_plugin"
msgstr "Plugin"

msgid "trac_mode_questions"
msgstr "Answering All Questions Correctly"

msgid "trac_mode_questions_info"
msgstr "Users who answered all questions correctly will automatically be assigned with the status ‘Completed’. Please use this setting only if there actually are questions in the learning module."

msgid "trac_mode_scorm"
msgstr "Status is Determined by a Collection of SCORM Items"

msgid "trac_mode_scorm_info"
msgstr "The learning progress status will automatically be determined by the status of selected SCOs.<br />A user's learning progress status is determined by the learning progress status of a collection of SCOs: SCOs can be assigned to the collection on this screen after saving this setting."

msgid "trac_mode_scorm_package"
msgstr "Status is Determined by the Whole SCORM Package"

msgid "trac_mode_scorm_package_info"
msgstr "The learning progress status will automatically be determined by the status of the complete SCORM package. All comprised SCOs will matter for the learning progress."

msgid "trac_mode_study_programme"
msgstr "Study Programme Completed"

msgid "trac_mode_survey_finished"
msgstr "Survey Finished"

msgid "trac_mode_survey_finished_info"
msgstr "The survey has to be finished by an user to receive the status 'Completed'."

msgid "trac_mode_test_finished"
msgstr "Test Must Be Finished"

msgid "trac_mode_test_finished_info"
msgstr "A user's learning progress status is set to ‘Completed’ after the user clicks 'Finish the Test'. Regardless of whether or not the test was passed, the learning progress will be set to ‘Completed’."

msgid "trac_mode_test_passed"
msgstr "Test Must Be Passed"

msgid "trac_mode_test_passed_info"
msgstr "A user's learning progress status is set to ‘Completed’ after the user passed the test. Thresholds for passing the test can be set in the 'Settings'-tab at the section 'Mark Schema'."

msgid "trac_mode_tlt"
msgstr "Minimally Required Amount of Time Spent on Learning Module"

msgid "trac_mode_tlt_info"
msgstr "The status will be automatically set according to time a user spends working with the learning module. The status 'Completed' is assigned once users exceed the minimally required Typical Learning Time. <br />The Typical Learning Time can be specified in the 'Metadata'-tab."

msgid "trac_mode_visited_pages"
msgstr "Visiting All Pages"

msgid "trac_mode_visited_pages_info"
msgstr "The status ‘Completed’ is automatically assigned to a user once this user visited all pages of the learning module."

msgid "trac_mode_visits"
msgstr "Status is Determined from Number of Visits"

msgid "trac_mode_visits_info"
msgstr "A user's status will be automatically set to 'Completed' after this user has visited the learning module more than a specified number of times. Users will be informed about their number of visits to the learning module and to what percentage they have met the set requirements."

