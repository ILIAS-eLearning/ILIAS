msgid "dpro_accept_usr_agreement_anonymous"
msgstr "Datenschutzerklärung"

msgid "dpro_accept_usr_agreement_anonymous_intro"
msgstr "Bevor Sie zu ILIAS wechseln, akzeptieren Sie die folgende Datenschutzerklärung."

msgid "dpro_account_reg_not_possible"
msgstr "Eine Selbstregistrierung ist aktuell nicht möglich, da in dieser Installation keine Datenschutzerklärung angeboten wird. Bitte kontaktieren Sie die <a href=\"%1$s\">technische Betreuung</a> für weitere Informationen."

msgid "dpro_agree_date"
msgstr "Datenschutzerklärung zugestimmt am"

msgid "dpro_last_reset_date"
msgstr "Die Datenschutzerklärung wurde zuletzt am %s zurückgesetzt. Setzen Sie die Datenschutzerklärung nur zurück, wenn sich die Dokumente in der Zwischenzeit geändert haben und eine Zustimmung zu dieser geänderten Vereinbarung gewünscht ist."

msgid "dpro_mode"
msgstr "Zustimmungsmodus"

msgid "dpro_mode_desc"
msgstr "Stellen Sie hier ein wann und wie die Datenschutzerklärung akzeptiert werden muss."

msgid "dpro_no_acceptance"
msgstr "Bereitstellung der Dokumente ohne Zustimmung"

msgid "dpro_no_documents_exist"
msgstr "Aktuell liegen keine Dokumente der Datenschutzerklärung vor."

msgid "dpro_no_documents_exist_cant_save"
msgstr "Aktuell liegen keine Dokumente der Datenschutzerklärung vor. Bitte erstellen Sie mindestens ein Dokument um den Service zu aktivieren."

msgid "dpro_once"
msgstr "Einmaliges Akzeptieren des Dokumentes"

msgid "dpro_reset_for_all_users"
msgstr "Datenschutzerklärung zurücksetzen"

msgid "dpro_status_enable"
msgstr "Datenschutzerklärung aktivieren"

msgid "dpro_status_enable_desc"
msgstr "Benutzer werden zum Unterzeichnen der Datenschutzerklärung aufgefordert, bevor sie ILIAS nutzen können."

msgid "dpro_sure_reset_tos"
msgstr "Sind Sie sicher, dass die Datenschutzerklärung für alle Benutzer im System zurückgesetzt werden sollen? Dies betrifft auch jene Anmeldekonten, die z.B. für die SOAP Web-Services genutzt werden."

msgid "dpro_withdrawal_usr_deletion"
msgstr "Löschung des ILIAS-Kontos beim Widerruf der Datenschutzerklärung"

msgid "dpro_withdrawal_usr_deletion_desc"
msgstr "Wird die Zustimmung zur Datenschutzerklärung widerrufen, erfolgt automatisch die Löschung des ILIAS-Kontos."
