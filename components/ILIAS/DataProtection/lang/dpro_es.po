msgid "dpro_accept_usr_agreement_anonymous"
msgstr "Declaración de Protección de Datos"

msgid "dpro_accept_usr_agreement_anonymous_intro"
msgstr "Antes de proceder a ILIAS debe aceptar la siguiente Declaración de Protección de Datos."

msgid "dpro_account_reg_not_possible"
msgstr "El registro autónomo no es posible actualmente porque no hay ninguna Declaración de Protección de Datos disponible. Por favor, contacte con su <a href=\"%1$s\">administrador del sistema</a> para más información."

msgid "dpro_agree_date"
msgstr "Declaración de Protección de Datos aceptada el"

msgid "dpro_last_reset_date"
msgstr "La Declaración de Protección de Datos se reinició el %s. Solo reinicie la Declaración si se han realizado cambios en los documentos y requiere que todos los usuarios acepten los documentos de nuevo."

msgid "dpro_mode"
msgstr "Modo de Aceptación"

msgid "dpro_mode_desc"
msgstr "Por favor, configure cuándo y cómo debe aceptarse la Declaración de Protección de Datos."

msgid "dpro_no_acceptance"
msgstr "Nunca, solo informativa"

msgid "dpro_no_documents_exist"
msgstr "Actualmente no hay documentos de Declaración de Protección de Datos disponibles."

msgid "dpro_no_documents_exist_cant_save"
msgstr "Actualmente no hay documentos de Declaración de Protección de Datos disponibles. Por favor, añada al menos un documento para activar este servicio."

msgid "dpro_once"
msgstr "Aceptar una vez"

msgid "dpro_reset_for_all_users"
msgstr "Reiniciar la Declaración de Protección de Datos"

msgid "dpro_status_enable"
msgstr "Activar la Declaración de Protección de Datos"

msgid "dpro_status_enable_desc"
msgstr "Muestra los documentos de la Declaración de Protección de Datos correspondientes al idioma al final del formulario de registro para nuevos usuarios y, si procede, tras el primer inicio de sesión del usuario. Los usuarios deben aceptar la Declaración de Protección de Datos antes de poder entrar en ILIAS."

msgid "dpro_sure_reset_tos"
msgstr "¿Está seguro de que desea restablecer la Declaración de Protección de Datos para todos los usuarios del sistema? Esto también se aplica, por ejemplo, a aquellas cuentas que se utilizan para los servicios web SOAP."

msgid "dpro_withdrawal_usr_deletion"
msgstr "Eliminación de la cuenta tras la revocación de la Declaración de Protección de Datos"

msgid "dpro_withdrawal_usr_deletion_desc"
msgstr "Si un usuario revoca su aceptación de un documento de Declaración de Protección de Datos previamente aceptado, esto resultará en la eliminación de la cuenta del usuario."
