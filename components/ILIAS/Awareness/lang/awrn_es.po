msgid "awareness_now_online"
msgstr "En línea ahora"

msgid "awareness_settings"
msgstr "Ajustes"

msgid "awrn_caching_period"
msgstr "Periodo de almacenamiento en caché"

msgid "awrn_caching_period_info"
msgstr "Tiempo de espera antes de que se actualice el número de usuarios en la barra superior y se determinen los nuevos usuarios en línea."

msgid "awrn_enable"
msgstr "Activar herramienta '¿Quién está en línea?'"

msgid "awrn_filter"
msgstr "Filtro de usuario"

msgid "awrn_hide_from_awareness"
msgstr "Ocultarme de la herramienta '¿Quién está en línea?'"

msgid "awrn_hide_from_awareness_info"
msgstr "La herramienta '¿Quién está en línea?' se encuentra en la barra de encabezado y enumera a los usuarios seleccionados (por ejemplo, contactos o miembros de sus cursos)."

msgid "awrn_inactive"
msgstr "No listado"

msgid "awrn_incl_offline"
msgstr "En línea y desconectado"

msgid "awrn_max_inactivity"
msgstr "Periodo máximo de inactividad"

msgid "awrn_max_inactivity_info"
msgstr "Después de este periodo, se considera que los usuarios están desconectados. Si no se establece nada, se utilizará el tiempo de la sesión."

msgid "awrn_max_nr_entries"
msgstr "Número máximo de elementos"

msgid "awrn_max_nr_entries_info"
msgstr "Número máximo de elementos en la lista '¿Quién está en línea?'. Este ajuste solo tiene una influencia mínima en el rendimiento al mostrar la herramienta en la barra superior."

msgid "awrn_minutes"
msgstr "min"

msgid "awrn_online"
msgstr "En línea"

msgid "awrn_online_only"
msgstr "Solo en línea"

msgid "awrn_seconds"
msgstr "seg"

msgid "awrn_use_osd"
msgstr "Ventana emergente de usuarios en línea"

msgid "awrn_use_osd_info"
msgstr "Mostrar una ventana emergente para indicar nuevos usuarios en línea en la lista «¿Quién está en línea?»."

msgid "awrn_user_show"
msgstr "¿Mostrar tu cuenta en «Quién está en línea»?"

msgid "awrn_user_show_default"
msgstr "Default Value for  the Visibility in \"Who-Is-Online?\""

msgid "awrn_user_show_default_info"
msgstr "Defines the default value for the visibility of the status of a user in \"Who-Is-Online?\"."

msgid "user_awrn_default"
msgstr "Predeterminado"

msgid "user_awrn_hide"
msgstr "Ocultar mi estado"

msgid "user_awrn_show"
msgstr "Mostrar mi estado"
