msgid "no_tag_text_1"
msgstr "Sie haben aktuell noch keine Tags genutzt. Um dies zu tun, müssen Sie zwei Schritte machen:"

msgid "no_tag_text_2"
msgstr "Klicken Sie auf „%s“ und wählen Sie aus dem verfügbaren Angebot ein Lernobjekt aus, z. B. ein Lernmodul oder ein Forum."

msgid "no_tag_text_3"
msgstr "Öffnen Sie dann das <i>Aktionen</i>-Menü des Objektes und wählen Sie \"<i>Tags setzen</i>\"."

msgid "tag_remove_tags_of_obj_without_access"
msgstr "Tag entfernen"

msgid "tag_some_obj_tagged_without_access"
msgstr "Zu einigen der getaggten Objekte haben Sie keinen Zugriff mehr. Sollen der Tag zu diesen Objekten entfernt werden?"

msgid "tag_tags_deleted"
msgstr "Tag wurde für Objekte ohne Zugriff entfernt."

msgid "tagging_all_users"
msgstr "Alle Benutzer"

msgid "tagging_edit_settings"
msgstr "Einstellungen"

