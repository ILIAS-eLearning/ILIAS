msgstr "Um Inhalte mit Tags (Schlagwörtern) auszuzeichnen, öffnen Sie den Reiter „Info“ des Objekts und geben dort die Tags ein."

msgid "tagging_tags"
msgstr "Tags"

msgid "tagging_users_using_tag"
