msgid "ps_password_max_length"
msgstr "Longitud máxima de la contraseña"

msgid "ps_password_max_length_info"
msgstr "Introduzca el tamaño máximo permitido para las contraseñas de las cuentas. Establezca 0 para desactivar esta opción."

msgid "ps_password_min_length"
msgstr "Longitud mínima de la contraseña"

msgid "ps_password_min_length_info"
msgstr "Introduzca la longitud mínima requerida para las contraseñas de las cuentas. Si se establece en 0, las contraseñas seguirán requiriendo una longitud mínima de 1. Si se modifica la longitud requerida, el nuevo requisito se aplicará sólo a las cuentas creadas o modificadas después de establecer la nueva longitud. Las cuentas existentes no se verán afectadas."

