msgid "bgtask_blocked"
msgstr "Descarga concurrente"

msgid "bgtask_blocked_cancel_new"
msgstr "Cancelar nueva descarga"

msgid "bgtask_blocked_cancel_old"
msgstr "Cancelar descarga existente"

msgid "bgtask_blocked_info"
msgstr "Ya hay una descarga procesándose para usted."

msgid "bgtask_cron_gc_desc"
msgstr "Elimina archivos obsoletos creados por tareas en segundo plano."

msgid "bgtask_cron_gc_title"
msgstr "Recolección de basura de tareas en segundo plano"

msgid "bgtask_download_long"
msgstr "El procesamiento de la descarga con %1$s archivos (%2$s) podría tardar un tiempo."

msgid "bgtask_download_too_large"
