msgid "bgtask_empty_folder"
msgstr "La selección actual no incluye ningún contenido descargable."

msgid "bgtask_failure"
msgstr "Error"

msgid "bgtask_processing"
msgstr "Creando descarga"

msgid "bgtask_setting"
msgstr "\"Descarga en segundo plano\" activada"

msgid "bgtask_setting_info"
msgstr "La creación del archivo ZIP se realiza de forma asíncrona y puede cancelarse en cualquier momento."

msgid "bgtask_setting_limit"
msgstr "Límite global"

msgid "bgtask_setting_limit_info"
msgstr "Una descarga solo es posible si la suma de los tamaños de los archivos es inferior a este valor en MB."

msgid "bgtask_setting_threshold_count"
msgstr "Número mínimo"

msgid "bgtask_setting_threshold_count_info"
msgstr "Si el número de archivos supera este valor, la descarga será asíncrona."

msgid "bgtask_setting_threshold_size"
msgstr "Tamaño mínimo"

