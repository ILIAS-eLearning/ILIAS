msgid "configure_geolocation"
msgstr "Um nach Adressen suchen zu können, schließen Sie bitte die Konfiguration für die Geolocation im Administrationsmenü „ILIAS erweitern > Karten“ ab."

msgid "maps_custom_geolocation_server_info"
msgstr "URL des Servers, über den die Geolocation-Daten mithilfe des Nominatim-Dienstes bereitgestellt werden. Der Eintrag muss den Platzhalter [QUERY] enthalten, um die Anfrageposition festzulegen. Beispiel: https://nominatim.example.com/search?q=[QUERY]&format=json"

msgid "maps_custom_tile_server_info"
msgstr "URL des Servers für die Bereitstellung der Kacheln. Mehrere Einträge müssen mit Leerzeichen getrennt werden. Standardeingabe ist „%s“."

msgid "maps_enable_maps"
msgstr "Karten aktivieren"

msgid "maps_enable_maps_info"
