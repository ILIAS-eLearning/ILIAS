<IfModule mod_rewrite.c>
	RewriteEngine on
	RewriteRule ^go\/(.*)$ goto.php/$1 [L]
	RewriteCond %{QUERY_STRING}  ^lang=([^=]*)$
	RewriteRule ^goto_(.*)_(wiki_([0-9]+|wpage)(.*)).html$ goto.php?client_id=$1&target=$2&lang=%1 [L]
	RewriteRule ^goto_(.*)_(wiki_([0-9]+|wpage)(.*)).html$ goto.php?client_id=$1&target=$2 [L]
	RewriteRule ^([^\/]*)_user_(.*)$ goto.php?client_id=$1&target=usr_n$2 [L]
	RewriteRule ^goto_(.*)_(usr_([a-z]+)).html$ goto.php?client_id=$1&target=$2 [L]
	RewriteCond %{QUERY_STRING}  ^lang=([^=]*)$
	RewriteRule ^goto_(.*)_([a-z]+_[0-9]+(.*)).html$ goto.php?client_id=$1&target=$2&lang=%1 [L]
	RewriteRule ^goto_(.*)_([a-z]+_[0-9]+(.*)).html$ goto.php?client_id=$1&target=$2 [L]
	RewriteRule ^data/.*/.*/.*$ ./Services/WebAccessChecker/wac.php [L]
	RewriteCond %{HTTP_USER_AGENT} ^(DavClnt)$
	RewriteCond %{REQUEST_METHOD} ^(OPTIONS)$
	RewriteRule .* "-" [R=401,L]
</IfModule>
<IfModule mod_alias.c>
	RedirectMatch 404 /\.git
	RedirectMatch 404 /patches
	RedirectMatch 404 /\.github
</IfModule>
<IfModule mod_xsendfile.c>
	XSendFile On
</IfModule>

AddType video/ogg .ogv
AddType video/mp4 .mp4
AddType video/webm .webm
AddType audio/mp3 .mp3


RewriteEngine On

# Block legacy Lucene search route that triggers ilCtrlException
RewriteCond %{QUERY_STRING} "(^|&)cmdClass=ilLuceneSearchGUI(&|$)" [NC]
RewriteRule ^ - [G]

# Fix bare /ilias.php (HEAD/GET ohne baseClass) -> /login.php
<IfModule mod_rewrite.c>
  RewriteEngine On
  # nur /ilias.php abfangen
  RewriteCond %{REQUEST_URI} ^/ilias\.php$ [NC]
  # HEAD oder GET
  RewriteCond %{REQUEST_METHOD} HEAD [OR]
  RewriteCond %{REQUEST_METHOD} GET
  # nur wenn KEIN baseClass-Parameter vorhanden ist
  RewriteCond %{QUERY_STRING} !(^|&)baseClass=[^&]+ [NC]
  RewriteRule ^ilias\.php$ /login.php [R=302,L]
</IfModule>

# .htaccess (ILIAS document root)

<IfModule mod_rewrite.c>
  RewriteEngine On

  # === ILIAS bad-ref_id guard ===
  # Block non-numeric ref_id to /ilias.php (bot scans, malformed links)
  RewriteCond %{REQUEST_URI} ^/ilias\.php$ [NC]
  RewriteCond %{QUERY_STRING} (?:^|&)ref_id=[^&]*[^0-9&] [NC]
  RewriteRule ^ - [F]

  # === ILIAS frameset guard ===
  # Strip cmd=frameset from queries to /ilias.php (keeps other params)
  RewriteCond %{REQUEST_URI} ^/ilias\.php$ [NC]
  RewriteCond %{QUERY_STRING} ^(.*)(^|&)cmd=frameset(&|$)(.*)$ [NC]
  RewriteRule ^ /ilias.php?%1%4 [R=302,L]

  # === ILIAS lucene guard ===
  # Block old/unsupported Lucene route that can trigger ilCtrlException
  RewriteCond %{REQUEST_URI} ^/ilias\.php$ [NC]
  RewriteCond %{QUERY_STRING} (?:^|&)cmdClass=ilLuceneSearchGUI(?:&|$) [NC]
  RewriteRule ^ - [G]   # 410 Gone

  # === ILIAS InfoScreen guard ===
  # Redirect direct showSummary hits with numeric ref_id to canonical goto.php
  RewriteCond %{REQUEST_URI} ^/ilias\.php$ [NC]
  RewriteCond %{QUERY_STRING} (^|&)cmd=showSummary(&|$) [NC]
  RewriteCond %{QUERY_STRING} (^|&)cmdClass=ilInfoScreenGUI(&|$) [NC]
  RewriteCond %{QUERY_STRING} (^|&)ref_id=([0-9]+)(&|$) [NC]
  RewriteRule ^ /goto.php/cat/%1 [R=302,L,E=INFOSCREEN_GUARD:1]
</IfModule>

# Marker header for logs/curl when the InfoScreen guard fired
<IfModule mod_headers.c>
  Header always set X-InfoScreen-Guard "active" env=INFOSCREEN_GUARD
</IfModule>

# === Optional: hard 403 for DotBot on dynamic entry points without session ===
<IfModule mod_rewrite.c>
  RewriteCond %{HTTP_USER_AGENT} DotBot [NC]
  RewriteCond %{REQUEST_URI} ^/(ilias\.php|login\.php|goto\.php)$ [NC]
  RewriteRule ^ - [F]
</IfModule>



